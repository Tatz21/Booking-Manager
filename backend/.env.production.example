# ==========================================
# Production Environment Variables Template
# ==========================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL Database (Managed Cloud SQL / RDS / Render Postgres)
DATABASE_URL="postgresql://user:password@prod-postgres-host:5432/bookingsaas?schema=public&sslmode=require&connection_limit=20"

# JWT Authentication Secrets (Min 32 random characters)
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_DIFFERENT_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET_KEY"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Razorpay Subscriptions (Production Mode)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# CORS Allowed Origins
CORS_ORIGIN="https://yourdomain.com,https://admin.yourdomain.com"
