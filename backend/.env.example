# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_saas?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRATION="7d"

# Razorpay Payments (₹199/month subscription)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
SUBSCRIPTION_PLAN_PRICE_INR=199
SUBSCRIPTION_TRIAL_DAYS=7

# Application & CORS
APP_URL="http://localhost:3000"
CORS_ORIGIN="*"
THROTTLE_TTL=60
THROTTLE_LIMIT=100
