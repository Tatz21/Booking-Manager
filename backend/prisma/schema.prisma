// Prisma Schema for Multi-Tenant Appointment Booking SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationType {
  CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  CANCELLATION
  STAFF_ALERT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole             @default(OWNER)
  resetToken   String?
  resetTokenExpires DateTime?
  memberships  BusinessMembership[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([email])
  @@index([resetToken])
}

model Business {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  type              String?              // e.g. Barber, Salon, Clinic, Consultant
  description       String?
  phone             String?
  email             String?
  location          String?
  timezone          String               @default("Asia/Kolkata")
  currency          String               @default("INR")
  logoUrl           String?
  primaryColor      String               @default("#4F46E5")
  secondaryColor    String               @default("#6366F1")
  customDomain      String?              @unique
  tagline           String?
  bannerUrl         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  memberships       BusinessMembership[]
  services          Service[]
  staff             Staff[]
  staffServices     StaffService[]
  businessHours     BusinessHours[]
  staffAvailability StaffAvailability[]
  customers         Customer[]
  appointments      Appointment[]
  subscription      Subscription?
  payments          Payment[]
  bookingSettings   BookingSettings?
  auditLogs         AuditLog[]
  notifications     NotificationLog[]

  @@index([slug])
  @@index([customDomain])
}

model BusinessMembership {
  id         String       @id @default(uuid())
  userId     String
  businessId String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

model Service {
  id              String         @id @default(uuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  price           Int            // In integer minor units (paise: ₹100 = 10000)
  currency        String         @default("INR")
  isActive        Boolean        @default(true)
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices   StaffService[]
  appointments    Appointment[]

  @@index([businessId])
  @@index([businessId, isActive, isDeleted])
}

model Staff {
  id                String              @id @default(uuid())
  businessId        String
  name              String
  email             String?
  phone             String?
  roleTitle         String?
  isActive          Boolean             @default(true)
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices     StaffService[]
  staffAvailability StaffAvailability[]
  appointments      Appointment[]

  @@index([businessId])
  @@index([businessId, isActive, isDeleted])
}

model StaffService {
  id         String   @id @default(uuid())
  businessId String
  staffId    String
  serviceId  String
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([businessId])
  @@index([staffId])
  @@index([serviceId])
}

model BusinessHours {
  id          String   @id @default(uuid())
  businessId  String
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime    String   // "09:00" in 24-hr format
  closeTime   String   // "18:00" in 24-hr format
  isClosed    Boolean  @default(false)
  breaksJson  Json?    // Array of { start: "13:00", end: "14:00" }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model StaffAvailability {
  id          String   @id @default(uuid())
  businessId  String
  staffId     String
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime   String   // "09:00"
  endTime     String   // "18:00"
  isOff       Boolean  @default(false)
  breaksJson  Json?    // Array of { start: "13:00", end: "14:00" }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([businessId])
  @@index([staffId])
}

model Customer {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  email        String
  phone        String
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
  @@index([businessId, email])
  @@index([businessId, phone])
}

model Appointment {
  id            String            @id @default(uuid())
  businessId    String
  customerId    String
  serviceId     String
  staffId       String
  startAt       DateTime          // Stored in UTC
  endAt         DateTime          // Stored in UTC
  status        AppointmentStatus @default(CONFIRMED)
  price         Int               // In minor units (paise)
  currency      String            @default("INR")
  notes         String?
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  notifications NotificationLog[]

  @@index([businessId])
  @@index([staffId, startAt, endAt])
  @@index([businessId, startAt])
  @@index([customerId])
  @@index([status])
}

model Subscription {
  id                     String             @id @default(uuid())
  businessId             String             @unique
  plan                   String             @default("MONTHLY_STANDARD")
  status                 SubscriptionStatus @default(TRIALING)
  trialStart             DateTime           @default(now())
  trialEnd               DateTime
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  business               Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments               Payment[]

  @@index([businessId])
  @@index([status])
}

model Payment {
  id                 String        @id @default(uuid())
  businessId         String
  subscriptionId     String?
  amount             Int           // In minor units (paise: ₹199 = 19900)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model BookingSettings {
  id                           String   @id @default(uuid())
  businessId                   String   @unique
  slotIntervalMinutes          Int      @default(30)
  advanceBookingDays           Int      @default(30)
  minNoticeMinutes             Int      @default(60) // 1 hour minimum notice
  cancellationNoticeHours      Int      @default(24) // 24 hours cancellation notice
  emailNotificationsEnabled    Boolean  @default(true)
  smsNotificationsEnabled      Boolean  @default(true)
  whatsappNotificationsEnabled Boolean  @default(true)
  reminder24hEnabled           Boolean  @default(true)
  reminder2hEnabled            Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  business                     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model RefreshToken {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  replacedByTokenId String?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  userId     String?
  action     String   // e.g. "APPOINTMENT_CREATED", "BUSINESS_UPDATED"
  entityType String   // e.g. "Appointment", "Business", "Payment"
  entityId   String?
  payloadJson Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

model NotificationLog {
  id            String              @id @default(uuid())
  businessId    String
  appointmentId String?
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus  @default(SENT)
  recipient     String              // email or phone number
  subject       String?
  content       String?
  error         String?
  metadataJson  Json?
  sentAt        DateTime            @default(now())

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([appointmentId])
  @@index([type, status])
  @@index([sentAt])
}
